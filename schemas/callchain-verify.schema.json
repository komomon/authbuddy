{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Call Chain Verification Output Schema",
  "description": "A02b output: verification audit of callchain.json",
  "type": "object",
  "required": ["overall_pass", "missing_nodes", "incorrect_edges", "premature_terminations", "review_notes"],
  "properties": {
    "overall_pass": {"type": "boolean"},
    "missing_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["caller_node_id", "call_site_line", "expression", "target_function", "target_file", "target_line", "severity", "reason", "code_snippet"],
        "properties": {
          "caller_node_id": {"type": "string"},
          "call_site_line": {"type": "number"},
          "expression": {"type": "string"},
          "target_function": {"type": "string"},
          "target_file": {"type": "string"},
          "target_line": {"type": "number"},
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "reason": {"type": "string", "minLength": 1},
          "code_snippet": {"type": "string", "minLength": 1}
        }
      }
    },
    "incorrect_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edge", "issue", "severity", "code_snippet"],
        "properties": {
          "edge": {"type": "string"},
          "issue": {"type": "string"},
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "code_snippet": {"type": "string"}
        }
      }
    },
    "premature_terminations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "termination", "issue", "severity", "code_snippet"],
        "properties": {
          "node_id": {"type": "string"},
          "termination": {"type": "string"},
          "issue": {"type": "string"},
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "code_snippet": {"type": "string"}
        }
      }
    },
    "review_notes": {"type": "array", "items": {"type": "string"}}
  }
}
